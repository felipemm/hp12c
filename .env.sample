# HP12C Calculator Environment Variables
# Copy this file to .env and customize as needed

# =============================================================================
# Application Configuration
# =============================================================================

# Custom data directory for configuration and memory files
# If not set, uses platform-specific user data directory or ./data as fallback
# Examples:
#   HP12C_DATA_DIR=/path/to/custom/data
#   HP12C_DATA_DIR=./data
HP12C_DATA_DIR=./data

# =============================================================================
# Python Runtime Environment Variables
# =============================================================================

# Prevent Python from writing .pyc bytecode files
# Set to 1 to disable bytecode cache creation
PYTHONDONTWRITEBYTECODE=1

# Unbuffered output for better logging (recommended for development)
# Set to 1 to disable output buffering
PYTHONUNBUFFERED=1

# Python hash seed for reproducible builds (optional)
# Set to a fixed integer for reproducibility, or 'random' for security
# PYTHONHASHSEED=random

# =============================================================================
# Type Checking and Linting Cache
# =============================================================================

# MyPy cache directory
# Set to /tmp or /dev/null to avoid creating .mypy_cache in project
# Default: .mypy_cache in project root
MYPY_CACHE_DIR=/tmp/mypy_cache

# Ruff cache directory
# Set to /tmp to avoid creating .ruff_cache in project
# Default: .ruff_cache in project root
RUFF_CACHE_DIR=/tmp/ruff_cache

# =============================================================================
# Testing and Coverage Cache
# =============================================================================

# Pytest cache directory
# Set to /tmp to avoid creating .pytest_cache in project
# Default: .pytest_cache in project root
PYTEST_CACHE_DIR=/tmp/pytest_cache

# Coverage data file location (optional)
# Set to /tmp to avoid creating .coverage files in project
# COVERAGE_FILE=/tmp/.coverage

# =============================================================================
# Package Management Cache
# =============================================================================

# Pip cache directory
# Set to /tmp or /dev/null to avoid creating pip cache
# Default: platform-specific cache directory
# PIP_CACHE_DIR=/tmp/pip_cache

# PyInstaller cache directory
# Set to /tmp to avoid creating PyInstaller cache in project
# Default: .pyinstaller_cache in project root
PYINSTALLER_CACHE_DIR=/tmp/pyinstaller_cache

# =============================================================================
# Optional: Development Tools
# =============================================================================

# Pylint cache directory (if using pylint)
# PYLINT_HOME=/tmp/pylint_cache

# Black cache directory (if using black)
# BLACK_CACHE_DIR=/tmp/black_cache

# =============================================================================
# Notes
# =============================================================================
# - Setting cache directories to /tmp means they will be cleaned on system reboot
# - Some tools may not respect these environment variables
# - For complete cache prevention, you may need to use tool-specific flags
# - Consider adding these to your shell profile (.bashrc, .zshrc, etc.) for persistence
